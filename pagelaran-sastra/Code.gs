        "</td></tr>" +
      "</table>" +
    "</td></tr>" +
    '<tr><td style="background:#FAD68A;padding:22px 36px;border-top:3px solid ' + ink + '">' +
      '<p style="margin:0;font-size:13px;line-height:1.7;color:' + ink + '">' + contact + "</p>" +
