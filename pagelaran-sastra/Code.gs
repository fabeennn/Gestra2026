function sendMail(to, subject, plain, html) {
  const opts = {
    name: CFG.SENDER_NAME,
    htmlBody: html,
    inlineImages: { gestraLogo: Utilities.newBlob(Utilities.base64Decode(LOGO_BASE64), "image/png", "logo.png") }
  };
  if (CFG.REPLY_TO) opts.replyTo = CFG.REPLY_TO;
  MailApp.sendEmail(to, subject, plain, opts);
}

function sendOrderEmail(order, person, status) {
  const ok = status === STATUS_OK;
  const o = Object.assign({}, order, { status: status });
  const heading = ok ? "Pembayaran terverifikasi" : "Pemesanan kami terima";
  const note = ok
    ? "pembayaranmu sudah kami verifikasi dan tiketmu resmi aktif. Simpan email ini dan tunjukkan kode tiket di bawah saat masuk venue."
    : "pemesananmu sudah kami terima dan sedang menunggu verifikasi pembayaran oleh panitia. Kami akan mengirim email lagi setelah pembayaranmu terverifikasi.";
  const subject = (ok ? "Pembayaran Terverifikasi - " : "Bukti Pemesanan ") + CFG.EVENT_NAME + " - " + order.code;
  try {
    sendMail(person.email, subject, "Kode tiket: " + order.code, emailHtml(o, person, heading, note));
    return true;
  } catch (err) {
    console.error("Email gagal: " + err);
    return false;
  }
}

function onStatusEdit(e) {
  const sh = e.range.getSheet();
  if (sh.getName() !== CFG.SHEET_NAME) return;
  const c1 = e.range.getColumn();
  const c2 = c1 + e.range.getNumColumns() - 1;
  if (COL.STATUS < c1 || COL.STATUS > c2) return;
  const r1 = Math.max(2, e.range.getRow());
  const r2 = e.range.getRow() + e.range.getNumRows() - 1;
  for (let row = r1; row <= r2; row++) {
    notifyRow(sh, row);
  }
}

function notifyRow(sh, row) {
  const r = sh.getRange(row, 1, 1, HEADERS.length).getValues()[0];
  const status = String(r[COL.STATUS - 1]).toUpperCase();
  if (status !== STATUS_OK && status !== STATUS_NO) return;
  if (String(r[COL.NOTIF - 1]).toUpperCase() === status) return;
  const code = r[COL.KODE - 1];
  if (!code) return;

  const person = { nama: r[COL.NAMA - 1], email: r[COL.EMAIL - 1], hp: String(r[COL.HP - 1]) };
  const label = r[COL.TIKET - 1];
  const all = sh.getRange(2, 1, sh.getLastRow() - 1, HEADERS.length).getValues().filter((x) => x[COL.KODE - 1] === code);
  const order = {
    code: code,
    label: label,
    qty: all.length,
    total: all.reduce((s, x) => s + (Number(x[COL.TOTAL - 1]) || 0), 0),
    people: all.map((x) => ({ nama: x[COL.NAMA - 1], email: x[COL.EMAIL - 1], hp: String(x[COL.HP - 1]) })),
    status: status
  };

  try {
    let sent = false;
    if (status === STATUS_OK) {
      sent = sendOrderEmail(order, person, STATUS_OK);
    } else {
      sendMail(
        person.email,
        "Pembayaran Ditolak - " + code,
        "Pembayaran ditolak. Kode tiket: " + code,
        emailHtml(order, person, "Pembayaran belum dapat diverifikasi", "bukti pembayaranmu belum dapat kami verifikasi. Silakan hubungi panitia.")
      );
      sent = true;
    }
    if (sent) sh.getRange(row, COL.NOTIF).setValue(status);
  } catch (err) {
    console.error("Notifikasi gagal baris " + row + ": " + err);
  }
}

function installStatusTrigger() {
  const ss = CFG.SPREADSHEET_ID ? SpreadsheetApp.openById(CFG.SPREADSHEET_ID) : SpreadsheetApp.getActiveSpreadsheet();
  ScriptApp.getProjectTriggers().forEach((t) => {
    if (t.getHandlerFunction() === "onStatusEdit") ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger("onStatusEdit").forSpreadsheet(ss).onEdit().create();
}

const LOGO_BASE64 = "";

const PATTERN_BASE64 = "";
