  const ink = "#2b1c17";
  const box = "border-collapse:separate;border-spacing:0;background:#ffffff;border:3px solid " + ink + ";border-right-width:6px;border-bottom-width:6px;";

  const pattern = getPatternUrl();
  const bodyStyle = pattern
    ? "background-color:#fffaf0;background-image:url('" + pattern + "');background-repeat:repeat-y;background-size:100% auto;background-position:top center;"
    : "background-color:#fffaf0;";
  const bodyAttr = pattern ? ' background="' + pattern + '"' : "";

  const detailRows = [
    ["KATEGORI", h(order.label), false],
    ["JUMLAH TIKET", String(order.qty), false],
    ["TOTAL BAYAR", '<span style="font-size:18px;color:#973031">' + rupiah(order.total) + "</span>", false],
    ["STATUS", '<span style="display:inline-block;background:' + badgeBg + ";color:" + badgeFg + ";border:2px solid " + ink + ';padding:4px 12px;font-size:12px;font-weight:bold;letter-spacing:0.5px">' + h(status) + "</span>", true]
  ];
  const details = detailRows.map((r) => {
    const line = r[2] ? "" : "border-bottom:2px solid " + ink + ";";
    return '<tr><td style="background:#F4E7B2;' + line + "border-right:2px solid " + ink + ';padding:13px 16px;font-size:12px;font-weight:bold;letter-spacing:1px;color:' + ink + ';width:40%">' + r[0] + '</td><td style="background:#ffffff;' + line + "padding:13px 16px;font-size:15px;font-weight:bold;color:" + ink + '">' + r[1] + "</td></tr>";
  }).join("");

  const cellBase = "padding:12px 16px;font-size:14px;color:" + ink + ";";
  const last = order.people.length - 1;
  const rows = order.people.map((p, i) => {
    const bg = i % 2 === 0 ? "#ffffff" : "#FBF5DC";
