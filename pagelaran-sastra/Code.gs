    : "Ada pertanyaan? Balas email ini untuk menghubungi panitia.";

  return '<div style="background:#F4E7B2;padding:32px 12px;font-family:Arial,Helvetica,sans-serif">' +
  '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;margin:0 auto;background:#ffffff;border:3px solid ' + ink + ';border-collapse:separate">' +
    '<tr><td style="background:#973031;padding:28px 32px">' +
      '<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>' +
        '<td width="96" style="vertical-align:middle"><img src="cid:gestraLogo" width="88" height="88" alt="Logo Pagelaran Sastra" style="display:block;border:0"></td>' +
        '<td style="vertical-align:middle;padding-left:20px">' +
          '<div style="font-size:12px;letter-spacing:2px;color:#FAD68A;font-weight:bold">BUKTI PEMESANAN TIKET</div>' +
          '<div style="font-size:24px;line-height:1.3;font-weight:bold;color:#F4E7B2;margin-top:6px">' + h(CFG.EVENT_NAME) + "</div>" +
        "</td>" +
      "</tr></table>" +
    "</td></tr>" +
    '<tr><td' + bodyAttr + ' style="padding:0;' + bodyStyle + '">' +
      '<table role="presentation" width="100%" cellpadding="0" cellspacing="0">' +
        '<tr><td style="padding:36px 36px 8px">' +
          '<div style="font-size:22px;font-weight:bold;color:' + ink + '">' + h(heading) + "</div>" +
