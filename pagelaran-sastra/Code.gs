const CFG = {
  SPREADSHEET_ID: "",
  SHEET_NAME: "Pemesanan Pagelaran Sastra 2026",
  FOLDER_ID: "",
  EVENT_NAME: "Pagelaran Sastra 2026",
  SENDER_NAME: "Panitia Pagelaran Sastra 2026",
  REPLY_TO: "",
  CONTACT_WA: "",
  ENFORCE_DATES: false,
  MAX_PER_ORDER: 10,
  MAX_FILE_BYTES: 6 * 1024 * 1024
};

const HEADERS = [
  "Timestamp", "Email", "Nama", "No Telpon", "Instansi", "Info Penbes",
  "Jenis Tiket", "Harga", "Tiket Ke", "Kode Promo", "Bukti Pembayaran",
  "Status", "Kode Tiket", "Total Bayar", "Notif Terkirim"
];
const COL = { EMAIL: 2, NAMA: 3, HP: 4, TIKET: 7, STATUS: 12, KODE: 13, TOTAL: 14, NOTIF: 15 };
const STATUS_WAIT = "MENUNGGU VERIFIKASI";
const STATUS_OK = "TERVERIFIKASI";
const STATUS_NO = "DITOLAK";

const TICKETS = {
  "Early Bird": { group: "earlybird", price: 30000, quota: 50, size: 1, enabled: true, start: "2026-10-05T15:00:00+07:00", end: "2026-10-12T15:00:00+07:00" },
  "Reguler - Hudoq": { group: "reguler", price: 35000, quota: 350, size: 1, enabled: false, start: "2026-10-12T15:00:00+07:00", end: "2026-12-04T15:00:00+07:00" },
  "VIP - Majau": { group: "reguler", price: 45000, quota: 100, size: 1, enabled: false, start: "2026-10-12T15:00:00+07:00", end: "2026-12-04T15:00:00+07:00" },
  "VVIP - Datun Julud": { group: "reguler", price: 65000, quota: 100, size: 1, enabled: false, start: "2026-10-12T15:00:00+07:00", end: "2026-12-04T15:00:00+07:00" },
  "Bundling - Couple": { group: "bundling", price: 65000, quota: 50, size: 2, enabled: false, start: "2026-11-01T15:00:00+07:00", end: "2026-11-15T15:00:00+07:00" },
  "Bundling - Tripple": { group: "bundling", price: 100000, quota: 45, size: 3, enabled: false, start: "2026-11-01T15:00:00+07:00", end: "2026-11-15T15:00:00+07:00" },
  "Bundling - Squad": { group: "bundling", price: 170000, quota: 45, size: 5, enabled: false, start: "2026-11-01T15:00:00+07:00", end: "2026-11-15T15:00:00+07:00" },
  "Flash Sale - Hudoq": { group: "flash", price: 31500, quota: 50, size: 1, enabled: false, start: "2026-11-20T15:00:00+07:00", end: "2026-11-21T15:00:00+07:00" },
  "Flash Sale - Majau": { group: "flash", price: 41500, quota: 50, size: 1, enabled: false, start: "2026-11-20T15:00:00+07:00", end: "2026-11-21T15:00:00+07:00" },
  "Flash Sale - Datun Julud": { group: "flash", price: 61500, quota: 50, size: 1, enabled: false, start: "2026-11-20T15:00:00+07:00", end: "2026-11-21T15:00:00+07:00" }
};

const PROMOS = {
  "COUPLE26": { type: "bundle", label: "Bundling - Couple" },
  "TRIPPLE26": { type: "bundle", label: "Bundling - Tripple" },
  "SQUAD26": { type: "bundle", label: "Bundling - Squad" },
  "FLASH26": { type: "flash" }
};

function json(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

function getSheet() {
  const ss = CFG.SPREADSHEET_ID ? SpreadsheetApp.openById(CFG.SPREADSHEET_ID) : SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName(CFG.SHEET_NAME);
  if (!sh) sh = ss.insertSheet(CFG.SHEET_NAME);
  if (sh.getLastRow() === 0) {
    sh.getRange(1, 1, 1, HEADERS.length).setValues([HEADERS]).setFontWeight("bold").setBackground("#973031").setFontColor("#ffffff");
    sh.setFrozenRows(1);
    sh.getRange(2, 4, 2000, 1).setNumberFormat("@");
    const rule = SpreadsheetApp.newDataValidation().requireValueInList([STATUS_WAIT, STATUS_OK, STATUS_NO], true).build();
    sh.getRange(2, COL.STATUS, 2000, 1).setDataValidation(rule);
  }
  if (sh.getRange(1, COL.NOTIF).getValue() === "") {
    sh.getRange(1, COL.NOTIF).setValue(HEADERS[COL.NOTIF - 1]).setFontWeight("bold").setBackground("#973031").setFontColor("#ffffff");
  }
  return sh;
}

function isOpen(t) {
  if (!t.enabled) return false;
  if (!CFG.ENFORCE_DATES) return true;
  const now = Date.now();
  return now >= Date.parse(t.start) && now <= Date.parse(t.end);
}

function soldMap(sh) {
  const last = sh.getLastRow();
  const rows = {};
  if (last < 2) return {};
  const data = sh.getRange(2, 1, last - 1, HEADERS.length).getValues();
  data.forEach((r) => {
    const label = r[COL.TIKET - 1];
    const status = String(r[COL.STATUS - 1]).toUpperCase();
    if (!label || status === STATUS_NO) return;
    rows[label] = (rows[label] || 0) + 1;
  });
  const sold = {};
  Object.keys(rows).forEach((label) => {
    const t = TICKETS[label];
    sold[label] = t ? Math.ceil(rows[label] / t.size) : rows[label];
  });
  return sold;
}

function doGet(e) {
  const action = e && e.parameter ? e.parameter.action : "";
  if (action === "stock") {
    return json({ ok: true, sold: soldMap(getSheet()) });
  }
  if (action === "code") {
    const code = String(e.parameter.code || "").trim().toUpperCase();
    const promo = PROMOS[code];
    if (!promo) return json({ ok: false, message: "Kode tidak ditemukan." });
    if (promo.type === "bundle") {
      const t = TICKETS[promo.label];
      if (!isOpen(t)) return json({ ok: false, message: "Paket bundling ini belum dibuka atau sudah berakhir." });
      return json({ ok: true, type: "bundle", label: promo.label });
    }
    const anyOpen = Object.keys(TICKETS).some((k) => TICKETS[k].group === "flash" && isOpen(TICKETS[k]));
    if (!anyOpen) return json({ ok: false, message: "Flash sale belum dibuka atau sudah berakhir." });
    return json({ ok: true, type: "flash" });
  }
  return json({ ok: false, message: "Aksi tidak dikenal." });
}

function normalizePhone(v) {
  let d = String(v).replace(/\D/g, "");
  if (d.indexOf("62") === 0) return d;
  if (d.indexOf("0") === 0) return "62" + d.slice(1);
  if (d.indexOf("8") === 0) return "62" + d;
  return d;
}

function makeOrderCode() {
  const d = Utilities.formatDate(new Date(), "Asia/Jakarta", "yyyyMMdd");
  const n = Math.floor(1000 + Math.random() * 9000);
  return "TKT-" + d + "-" + n;
}

function validatePerson(p) {
  return p &&
    /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(p.email || "").trim()) &&
    String(p.nama || "").trim().length >= 3 &&
    String(p.hp || "").replace(/\D/g, "").length >= 9 &&
    String(p.instansi || "").trim().length > 0 &&
    String(p.info || "").trim().length > 0;
}

function doPost(e) {
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(30000);
  } catch (err) {
    return json({ ok: false, message: "Server sedang sibuk. Coba lagi sebentar." });
  }
  try {
    const d = JSON.parse(e.postData.contents);
    const t = TICKETS[d.ticketLabel];
    if (!t) return json({ ok: false, message: "Kategori tiket tidak dikenal." });
    if (!isOpen(t)) return json({ ok: false, message: "Penjualan kategori ini belum dibuka atau sudah berakhir." });

    const promoCode = String(d.promoCode || "").trim().toUpperCase();
    const promo = PROMOS[promoCode];
    if (t.group === "bundling" && !(promo && promo.type === "bundle" && promo.label === d.ticketLabel)) {
      return json({ ok: false, message: "Kode bundling tidak valid." });
    }
    if (t.group === "flash" && !(promo && promo.type === "flash")) {
      return json({ ok: false, message: "Kode flash sale tidak valid." });
    }

    const qty = t.group === "bundling" ? t.size : Number(d.qty);
    if (!qty || qty < 1 || qty > CFG.MAX_PER_ORDER) return json({ ok: false, message: "Jumlah tiket tidak valid." });
    const people = d.people || [];
    if (people.length !== qty || !people.every(validatePerson)) return json({ ok: false, message: "Data pemesan belum lengkap." });

    if (!d.proof || !d.proof.data) return json({ ok: false, message: "Bukti pembayaran belum diupload." });
    const bytes = Utilities.base64Decode(d.proof.data);
    if (bytes.length > CFG.MAX_FILE_BYTES) return json({ ok: false, message: "Ukuran bukti pembayaran terlalu besar." });

    const sh = getSheet();
    const sold = soldMap(sh)[d.ticketLabel] || 0;
    const need = t.group === "bundling" ? 1 : qty;
    if (t.quota - sold < need) {
      return json({ ok: false, message: t.quota - sold <= 0 ? "Tiket sudah habis terjual." : "Sisa tiket hanya " + (t.quota - sold) + "." });
    }

    const orderCode = makeOrderCode();
    const total = t.group === "bundling" ? t.price : t.price * qty;
    const perPrice = Math.round(total / qty);

    const mime = String(d.proof.mime || "image/jpeg");
    const ext = mime.indexOf("png") > -1 ? "png" : mime.indexOf("heic") > -1 ? "heic" : "jpg";
    const blob = Utilities.newBlob(bytes, mime, orderCode + "_" + String(people[0].nama).trim().replace(/[^\w]+/g, "_") + "." + ext);
    const folder = CFG.FOLDER_ID ? DriveApp.getFolderById(CFG.FOLDER_ID) : DriveApp.getRootFolder();
    const file = folder.createFile(blob);
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    const proofUrl = file.getUrl();

    const now = new Date();
    const rows = people.map((p, i) => [
      now,
      String(p.email).trim(),
      String(p.nama).trim(),
      normalizePhone(p.hp),
      String(p.instansi).trim(),
      String(p.info).trim(),
      d.ticketLabel,
      perPrice,
      i + 1,
      promoCode,
      proofUrl,
      STATUS_WAIT,
      orderCode,
      i === 0 ? total : "",
      ""
    ]);
    const start = sh.getLastRow() + 1;
    sh.getRange(start, 4, rows.length, 1).setNumberFormat("@");
    sh.getRange(start, 1, rows.length, HEADERS.length).setValues(rows);
    sh.getRange(start, 1, rows.length, 1).setNumberFormat("dd/MM/yyyy HH:mm:ss");
    sh.getRange(start, 8, rows.length, 1).setNumberFormat("[$Rp] #,##0");
    sh.getRange(start, 14, rows.length, 1).setNumberFormat("[$Rp] #,##0");
    SpreadsheetApp.flush();

    const order = { code: orderCode, label: d.ticketLabel, total: total, qty: qty, people: people, proofUrl: proofUrl };
    const seen = {};
    order.people.forEach((p) => {
      const key = String(p.email).trim().toLowerCase();
      if (seen[key]) return;
      seen[key] = true;
      sendOrderEmail(order, p, STATUS_WAIT);
    });

    return json({ ok: true, orderCode: orderCode, total: total });
  } catch (err) {
    console.error(err);
    return json({ ok: false, message: "Terjadi kesalahan di server. Coba lagi." });
  } finally {
    lock.releaseLock();
  }
}

function h(s) {
  return String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
}

function rupiah(n) {
  return "Rp " + Number(n).toLocaleString("id-ID");
}

function getPatternUrl() {
  try {
    const props = PropertiesService.getScriptProperties();
    let id = props.getProperty("PATTERN_FILE_ID");
    if (id) {
      try {
        if (DriveApp.getFileById(id).isTrashed()) id = "";
      } catch (e) {
        id = "";
      }
    }
    if (!id) {
      const blob = Utilities.newBlob(Utilities.base64Decode(PATTERN_BASE64), "image/jpeg", "email-pattern.jpg");
      const folder = CFG.FOLDER_ID ? DriveApp.getFolderById(CFG.FOLDER_ID) : DriveApp.getRootFolder();
      const file = folder.createFile(blob);
      file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
      id = file.getId();
      props.setProperty("PATTERN_FILE_ID", id);
    }
    return "https://lh3.googleusercontent.com/d/" + id;
  } catch (err) {
    console.error("Pola email gagal: " + err);
    return "";
  }
}

